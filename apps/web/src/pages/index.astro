---
import ArticleCard from '@/components/ArticleCard.astro';
import EventCard from '@/components/EventCard.astro';
import GeekDailyCard from '@/components/GeekDailyCard.astro';
import HeroNavIcon from '@/components/HeroNavIcon.astro';
import JobCard from '@/components/JobCard.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import RebaseLogo from '@/assets/rebase-logo-wordmark.svg';
import { createAvatarData } from '@/lib/avatar';
import { getHomeFeed, getSiteSettings } from '@/lib/content';
import { formatDate } from '@/lib/dates';

const [site, feed] = await Promise.all([getSiteSettings(), getHomeFeed()]);
const contributorPreviewLimit = 10;
const contributorPreview = feed.featuredContributors.slice(0, contributorPreviewLimit);
const liveWire = feed.dynamicFeed.slice(0, 4);
const recentGeekDaily = feed.recentGeekDaily.slice(0, 3);

const liveWireTypeLabel = {
  article: '文章',
  job: '招聘',
  event: '活动',
  geekdaily: 'GeekDaily',
} as const;

const heroNavigation = [
  { href: '/geekdaily', label: '极客日报', icon: 'newspaper' },
  { href: '/who-is-hiring', label: 'Who is hiring', icon: 'briefcase' },
  { href: '/articles', label: '文章', icon: 'pencil' },
  { href: '/events', label: '活动', icon: 'calendar' },
  { href: '/contributors', label: '贡献者们', icon: 'users' },
  { href: '/about', label: '关于Rebase', icon: 'info' },
] as const;
---

<BaseLayout site={site} title="Rebase 社区首页" description={site.description}>
  <div class="hero-scroll-stage">
    <section class="world-hero" aria-labelledby="world-title">
    <div class="hero-scene" data-hero-scene aria-hidden="true">
      <div class="hero-plane hero-plane-sky" data-hero-depth="0.08">
        <img class="hero-layer hero-sky-layer" src="/media/hero/nature/summer/sky.png" alt="" width="1536" height="864" fetchpriority="high" />
      </div>
      <div class="hero-plane hero-plane-clouds-back" data-hero-depth="0.18">
        <img class="hero-layer hero-clouds-back" src="/media/hero/nature/summer/cloud-layer-2.png" alt="" width="1536" height="864" />
      </div>
      <div class="hero-plane hero-plane-clouds-front" data-hero-depth="0.32">
        <img class="hero-layer hero-clouds-front" src="/media/hero/nature/summer/cloud-layer-1.png" alt="" width="1536" height="864" />
      </div>
      <div class="hero-plane hero-plane-light-rays" data-hero-depth="0.24">
        <img class="hero-layer hero-light-rays" src="/media/hero/nature/summer/light-rays.png" alt="" width="1536" height="864" />
      </div>
      <div class="hero-plane hero-plane-mountains" data-hero-depth="0.22">
        <img class="hero-layer hero-mountains" src="/media/hero/nature/summer/mountain.png" alt="" width="1536" height="864" style="transform:translateY(26%)" />
      </div>
      <div class="hero-plane hero-plane-valley" data-hero-depth="0.42">
        <img class="hero-layer hero-valley" src="/media/hero/nature/summer/valley.png" alt="" width="1536" height="864" style="transform:translateX(-10%) translateY(22%)" />
      </div>
      <div class="hero-plane hero-plane-grass-back" data-hero-depth="0.68">
        <img class="hero-layer hero-grass-back" src="/media/hero/nature/summer/grass-back.png" alt="" width="1536" height="864" style="transform:translateY(25%)" />
      </div>
      <div class="hero-plane hero-plane-ground-shadow" data-hero-depth="0.82">
        <img class="hero-layer hero-ground-shadow" src="/media/hero/nature/summer/ground-shadow.png" alt="" width="1536" height="864" />
      </div>
    </div>

    <div class="world-hero-content">
      <div class="hero-copy" data-hero-copy>
        <h1 id="world-title" class="hero-brand">
          <span class="hero-logo-lockup">
            <RebaseLogo class="hero-brand-logo" role="img" aria-label="Rebase" />
          </span>
        </h1>
        <p class="world-intro">由中国开发者们在业余时间用热爱建立的开发者社区</p>
      </div>
      <div class="hero-navigation-stage">
        <div class="hero-navigation-reveal" data-hero-navigation-reveal>
          <nav class="hero-navigation" data-hero-navigation data-intro-visible="false" aria-label="社区主要入口">
            <ul>
              {heroNavigation.map((item) => (
                <li>
                  <a href={item.href}>
                    <HeroNavIcon name={item.icon} />
                    <span class="hero-nav-label">{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    </div>
    </section>
  </div>

  <div class="home-modules">
    <section class="shell page-section current-desk" aria-label="社区正在发生什么">
    <aside class="signal-panel card live-desk">
      <SectionHeader compact title="社区正在发生什么" />
      <ol class="live-wire-list">
        {liveWire.map((item) => (
          <li class="live-wire-item">
            <a href={item.href}>
              <div class="live-wire-meta">
                <span>{liveWireTypeLabel[item.type]}</span>
                <time>{item.publishedAt ? formatDate(item.publishedAt) : '刚刚更新'}</time>
              </div>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
            </a>
          </li>
        ))}
      </ol>
    </aside>
  </section>

  <section class="shell meta-strip page-section">
    {site.homeStats.map((stat) => (
      <article class="card">
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
      </article>
    ))}
  </section>

  <section class="shell page-section">
    <SectionHeader
      compact
      title="近期极客日报"
      description="日报是最稳定的社区更新机制，紧随时代变化，也是搜索与RSS最常用的入口"
      href="/geekdaily"
      hrefLabel="浏览极客日报"
    />
    <div class="grid-3">
      {recentGeekDaily.map((episode) => (
        <GeekDailyCard episode={episode} compact />
      ))}
    </div>
  </section>

  <section class="shell page-section">
    <SectionHeader
      compact
      title="近期文章"
      description="从产品、社区、新技术、新探索到信息架构，公开记录社区内的想法"
      href="/articles"
      hrefLabel="浏览全部文章"
    />
    <div class="grid-3">
      {feed.latestArticles.map((article) => (
        <ArticleCard article={article} compact />
      ))}
    </div>
  </section>

  <section class="shell page-section dual-column">
    <SectionHeader
      compact
      title="新增招聘信息"
      description="由招聘方在社区github上提交的招聘信息，社区志愿者只做最简单的格式筛选，大家需要认真辨别"
      href="/who-is-hiring"
      hrefLabel="浏览全部职位"
    />
    <div class="grid-3">
      {feed.latestJobs.map((job) => (
        <JobCard job={job} compact />
      ))}
    </div>
  </section>

  <section class="shell page-section">
    <SectionHeader
      compact
      title="社区活动"
      description="由 Rebase 主办和参与合作的活动，以及在github上提交的活动都将展示在这里"
      href="/events"
      hrefLabel="查看活动"
    />
    <div class="grid-3">
      {feed.latestEvents.map((event) => (
        <EventCard event={event} compact />
      ))}
    </div>
  </section>

  <section class="shell page-section">
    <SectionHeader
      compact
      title="由更多真实的人，一起把社区持续往前推"
      href="/contributors"
      hrefLabel="查看全部贡献者"
    />
    <article class="card contributors-overview">
      <div class="contributors-copy">
        <p class="contributors-kicker">社区照片墙</p>
        <div class="contributors-intro">
          <h3>先看见真实的人，再进入完整的贡献者档案。</h3>
          <p>
            Rebase 由志愿者、编辑与长期协作者共同维护。这里先展示一组持续变化的公开面孔，让社区的气质先被看见。
          </p>
        </div>

        <p class="contributors-note">
          内容整理、活动组织、推荐协作与长期共建，都会慢慢沉淀成可被看见的记录。
        </p>
      </div>

      <div class="contributors-cloud" aria-hidden="true">
        {contributorPreview.map((contributor) => (
          <div class="avatar-token" title={contributor.name}>
            {contributor.avatarUrl ? (
              <img src={contributor.avatarUrl} alt="" loading="lazy" />
            ) : (
              <div class="avatar-fallback" style={`background:${createAvatarData(contributor.avatarSeed)}`}>
                <span>{contributor.name.slice(0, 1)}</span>
              </div>
            )}
          </div>
        ))}
      </div>
    </article>
  </section>

  <section class="shell page-section">
    <article class="card feed-strip">
      <div class="feed-strip-copy">
        <p class="feed-strip-label">RSS 订阅</p>
        <p>通过 RSS 持续追踪 Rebase 的公开内容更新。</p>
      </div>
      <div class="feed-strip-links">
        <a class="feed-primary-link" href="/rss.xml">全站 RSS <span>↗</span></a>
        <div class="feed-secondary-links">
          <a href="/geekdaily/rss.xml">极客日报</a>
          <a href="/articles/rss.xml">文章</a>
          <a href="/events/rss.xml">活动</a>
          <a href="/who-is-hiring/rss.xml">招聘</a>
        </div>
      </div>
    </article>
  </section>
  </div>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { Observer } from 'gsap/Observer';

  gsap.registerPlugin(Observer);

  const hero = document.querySelector<HTMLElement>('.world-hero');
  const scene = document.querySelector<HTMLElement>('[data-hero-scene]');
  const planes = Array.from(document.querySelectorAll<HTMLElement>('[data-hero-depth]'));
  const supportsTilt = window.matchMedia(
    '(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
  );

  if (hero && scene && planes.length && supportsTilt.matches && !scene.dataset.tiltReady) {
    scene.dataset.tiltReady = 'true';

    let frame = 0;
    let currentX = 0;
    let currentY = 0;
    let targetX = 0;
    let targetY = 0;

    const renderTilt = () => {
      currentX += (targetX - currentX) * 0.14;
      currentY += (targetY - currentY) * 0.14;

      if (Math.abs(targetX - currentX) < 0.002) currentX = targetX;
      if (Math.abs(targetY - currentY) < 0.002) currentY = targetY;

      for (const plane of planes) {
        const depth = Number(plane.dataset.heroDepth ?? 0);
        const rotateX = (currentX * depth).toFixed(3);
        const rotateY = (currentY * depth).toFixed(3);
        const scale = (1.006 + depth * 0.042).toFixed(3);

        plane.style.transform = `perspective(1200px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(${scale})`;
      }

      if (currentX !== targetX || currentY !== targetY) {
        frame = requestAnimationFrame(renderTilt);
      } else {
        frame = 0;
      }
    };

    const requestRender = () => {
      if (!frame) frame = requestAnimationFrame(renderTilt);
    };

    renderTilt();

    hero.addEventListener(
      'pointermove',
      (event) => {
        const bounds = hero.getBoundingClientRect();
        const x = ((event.clientX - bounds.left) / bounds.width) * 2 - 1;
        const y = ((event.clientY - bounds.top) / bounds.height) * 2 - 1;

        targetX = Math.max(-1, Math.min(1, y)) * -2;
        targetY = Math.max(-1, Math.min(1, x)) * 3;
        requestRender();
      },
      { passive: true },
    );

    const resetTilt = () => {
      targetX = 0;
      targetY = 0;
      requestRender();
    };

    hero.addEventListener('pointerleave', resetTilt);
    window.addEventListener('blur', resetTilt);
    window.addEventListener('scroll', resetTilt, { passive: true });
  }

  const heroCopy = document.querySelector<HTMLElement>('[data-hero-copy]');
  const heroNavigation = document.querySelector<HTMLElement>('[data-hero-navigation]');
  const heroNavigationReveal = document.querySelector<HTMLElement>('[data-hero-navigation-reveal]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && heroCopy && heroNavigation && heroNavigationReveal) {
    const syncNavigationAccess = (visible: boolean) => {
      const nextValue = String(visible);
      if (heroNavigation.dataset.introVisible === nextValue) return;

      heroNavigation.dataset.introVisible = nextValue;
      window.dispatchEvent(new Event('hero-navigation-visibility'));
    };

    if (reduceMotion) {
      heroCopy.classList.add('is-lifted');
      heroNavigationReveal.classList.add('is-visible');
      syncNavigationAccess(true);
    } else {
      gsap.set(heroNavigationReveal, { autoAlpha: 0, y: 28 });
      syncNavigationAccess(false);

      const introTimeline = gsap
        .timeline({
          paused: true,
          defaults: { ease: 'power2.out' },
          onUpdate: () => syncNavigationAccess(introTimeline.progress() > 0.56),
          onComplete: () => gestureObserver.disable(),
          onReverseComplete: () => syncNavigationAccess(false),
        })
        .to(heroCopy, { yPercent: -24, duration: 0.62 })
        .to(heroNavigationReveal, { autoAlpha: 1, y: 0, duration: 0.38 }, '-=0.04');

      const playIntro = () => {
        if (!introTimeline.isActive() && introTimeline.progress() < 1) {
          introTimeline.play();
        }
      };

      const gestureObserver = Observer.create({
        target: window,
        type: 'wheel,touch,pointer',
        preventDefault: true,
        tolerance: 12,
        onUp: playIntro,
        onDown: playIntro,
      });

      const handleLockedNavigationKey = (event: KeyboardEvent) => {
        if (!gestureObserver.isEnabled) return;
        if (!['ArrowDown', 'PageDown', ' ', 'End'].includes(event.key)) return;

        event.preventDefault();
        playIntro();
      };

      let previousScrollY = window.scrollY;

      const resetIntroAtTop = () => {
        const currentScrollY = window.scrollY;
        const returnedToTop = previousScrollY > 1 && currentScrollY <= 1;
        previousScrollY = currentScrollY;

        if (!returnedToTop || introTimeline.progress() < 1 || introTimeline.isActive()) return;

        gestureObserver.enable();
        introTimeline.reverse();
      };

      window.addEventListener('keydown', handleLockedNavigationKey);
      window.addEventListener('scroll', resetIntroAtTop, { passive: true });

      if (window.scrollY > 1) {
        introTimeline.progress(1);
        gestureObserver.disable();
      }
    }
  }
</script>

<style>
  .hero-scroll-stage {
    height: 100svh;
    background: #62bce7;
  }

  .world-hero {
    position: relative;
    height: 100svh;
    isolation: isolate;
    min-height: min(52rem, 100dvh);
    overflow: hidden;
    background: #62bce7;
    color: white;
  }

  .hero-scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-plane {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
    backface-visibility: hidden;
    will-change: transform;
  }

  .hero-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    user-select: none;
  }

  .hero-plane-sky { z-index: 0; }
  .hero-plane-clouds-back { z-index: 1; }
  .hero-plane-clouds-front { z-index: 2; }
  .hero-plane-light-rays { z-index: 3; }
  .hero-plane-mountains { z-index: 4; }
  .hero-plane-valley { z-index: 5; }
  .hero-plane-grass-back { z-index: 6; }
  .hero-plane-ground-shadow { z-index: 9; }

  .hero-light-rays { opacity: 0.34; mix-blend-mode: screen; }
  .hero-mountains { transform: translateY(26%); }
  .hero-valley { transform: translateX(-5%) translateY(22%); }
  .hero-grass-back { transform: translateY(16%); }

  .hero-scene::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 15;
    background: linear-gradient(180deg, rgba(19, 88, 128, 0.06), transparent 45%, rgba(29, 69, 34, 0.08));
  }

  .world-hero-content {
    position: absolute;
    inset: 0;
    z-index: 20;
    display: grid;
    place-items: center;
    justify-items: center;
    width: min(calc(100% - 2rem), 56rem);
    margin: 0 auto;
    text-align: center;
    text-shadow: 0 3px 18px rgba(24, 94, 126, 0.3);
  }

  .hero-copy {
    grid-area: 1 / 1;
    width: 100%;
    will-change: transform;
  }

  .hero-brand {
    width: 100%;
    margin: 0;
    line-height: 0;
  }

  .hero-logo-lockup {
    position: relative;
    isolation: isolate;
    display: block;
    width: clamp(17rem, 34vw, 27rem);
    aspect-ratio: 225 / 101;
    margin: 0 auto;
    filter: drop-shadow(0 4px 13px rgba(27, 77, 83, 0.16));
  }

  .hero-logo-lockup :global(.hero-brand-logo) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .world-intro {
    max-width: 30ch;
    margin: 1rem auto 0;
    font-size: clamp(1rem, 2vw, 1.24rem);
    line-height: 1.8;
  }

  .hero-navigation {
    width: 100%;
    max-width: 48rem;
    margin-inline: auto;
    transition: opacity 260ms ease, transform 260ms ease, visibility 0s linear 0s;
  }

  .hero-navigation-stage {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    transform: translate(-50%, clamp(7.5rem, 18vh, 9rem));
  }

  .hero-navigation-reveal {
    visibility: hidden;
    width: 100%;
    opacity: 0;
    transform: translateY(1.75rem);
    will-change: transform, opacity;
  }

  .hero-navigation-reveal.is-visible {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  .hero-navigation:global(.is-departing) {
    visibility: hidden;
    opacity: 0;
    transform: translateY(0.8rem);
    pointer-events: none;
    transition-delay: 0s, 0s, 260ms;
  }

  .hero-navigation ul {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(0.35rem, 1.4vw, 1rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-navigation a {
    display: grid;
    min-width: 0;
    min-height: 5rem;
    place-items: center;
    align-content: center;
    gap: 0.55rem;
    color: rgba(255, 255, 255, 0.96);
    font-size: clamp(0.78rem, 1.5vw, 0.94rem);
    font-weight: 700;
    line-height: 1.2;
    text-shadow: 0 2px 8px rgba(21, 80, 112, 0.34);
    transition: color 180ms ease, transform 180ms ease;
  }

  .hero-navigation a:hover,
  .hero-navigation a:focus-visible {
    color: #fff6aa;
    transform: translateY(-0.22rem);
  }

  .hero-nav-label {
    min-width: 0;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-logo-lockup :global(.hero-brand-logo path:nth-of-type(7)) {
      stroke-dasharray: 300;
      stroke-dashoffset: 300;
      animation: hero-logo-path-draw 1.25s 180ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .hero-logo-lockup :global(.hero-brand-logo path:nth-of-type(8)) {
      opacity: 0;
      animation: hero-logo-tip-show 120ms 650ms ease-out forwards;
    }

    .hero-logo-lockup :global(.hero-brand-logo path:nth-of-type(9)) {
      stroke-dasharray: 90;
      stroke-dashoffset: 90;
      animation: hero-logo-path-draw 280ms 520ms ease-out forwards;
    }

    .hero-clouds-back { animation: hero-clouds-back 72s ease-in-out infinite alternate; }
    .hero-clouds-front { animation: hero-clouds-front 48s ease-in-out infinite alternate; }
    .hero-light-rays { animation: hero-light 9s ease-in-out infinite; }
    .hero-flowers { animation: hero-flowers 5.2s ease-in-out infinite alternate; }
  }

  @keyframes hero-logo-path-draw { to { stroke-dashoffset: 0; } }
  @keyframes hero-logo-tip-show { to { opacity: 1; } }

  @keyframes hero-clouds-back { from { transform: translate3d(-1.2%, 0, 0) scale(1.025); } to { transform: translate3d(1.2%, 0, 0) scale(1.025); } }
  @keyframes hero-clouds-front { from { transform: translate3d(1.8%, 0, 0) scale(1.04); } to { transform: translate3d(-1.8%, 0, 0) scale(1.04); } }
  @keyframes hero-light { 0%, 100% { opacity: 0.26; } 50% { opacity: 0.48; } }
  @keyframes hero-flowers { from { rotate: -0.28deg; } to { rotate: 0.36deg; } }

  @media (max-width: 920px) {
    .world-hero { min-height: min(47rem, 100svh); }
    .hero-layer { object-position: 58% center; }
  }

  @media (max-width: 640px) {
    .world-hero { min-height: min(44rem, 100svh); }
    .world-hero-content { width: min(calc(100% - 1rem), 56rem); }
    .hero-logo-lockup { width: min(82vw, 20rem); }
    .world-intro { max-width: 23rem; padding: 0 1rem; font-size: 1rem; }
    .hero-navigation-stage { transform: translate(-50%, clamp(6.25rem, 15vh, 7.25rem)); }
    .hero-navigation ul { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.35rem 0.2rem; }
    .hero-navigation a { min-height: 4.35rem; gap: 0.4rem; font-size: 0.76rem; }
    .hero-layer { object-position: 66% center; }
    .hero-sky-layer,
    .hero-clouds-back,
    .hero-clouds-front,
    .hero-light-rays,
    .hero-mountains,
    .hero-valley,
    .hero-grass-back,
    .hero-flowers { object-position: center; }
  }

  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .hero-plane {
      transform: none;
      will-change: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy.is-lifted { transform: translateY(-24%); }
  }

  .home-hero {
    align-items: stretch;
  }

  .masthead-panel {
    position: relative;
    overflow: hidden;
    padding: 1.42rem 1.48rem 1.45rem;
    background:
      radial-gradient(circle at top left, rgba(243, 196, 110, 0.32), transparent 34%),
      radial-gradient(circle at 92% 18%, rgba(15, 118, 110, 0.16), transparent 22%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 251, 244, 0.92));
    border-color: rgba(15, 118, 110, 0.14);
    box-shadow: var(--shadow-soft);
  }

  .masthead-panel::before {
    content: 'REBASE';
    position: absolute;
    top: 1.2rem;
    right: 1.45rem;
    color: rgba(17, 94, 89, 0.03);
    font-family: var(--display-font);
    font-size: clamp(4.4rem, 8vw, 7rem);
    letter-spacing: 0.08em;
    line-height: 0.82;
    pointer-events: none;
  }

