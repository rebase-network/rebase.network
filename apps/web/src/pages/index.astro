---
import ArticleCard from '@/components/ArticleCard.astro';
import EventCard from '@/components/EventCard.astro';
import GeekDailyCard from '@/components/GeekDailyCard.astro';
import JobCard from '@/components/JobCard.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { createAvatarData } from '@/lib/avatar';
import { getHomeFeed, getSiteSettings } from '@/lib/content';
import { formatDate } from '@/lib/dates';

const [site, feed] = await Promise.all([getSiteSettings(), getHomeFeed()]);
const contributorPreview = feed.featuredContributors.slice(0, 10);
const liveWire = feed.dynamicFeed.slice(0, 4);
const recentGeekDaily = feed.recentGeekDaily.slice(0, 3);

const liveWireTypeLabel = {
  article: '图书馆',
  job: '招聘驿站',
  event: '活动广场',
  geekdaily: '公告板',
} as const;

const worldGates = [
  { href: '/geekdaily', place: '公告板', label: '极客日报', description: '每天贴上新的发现' },
  { href: '/articles', place: '图书馆', label: '社区文章', description: '把经验留在书架上' },
  { href: '/who-is-hiring', place: '招聘驿站', label: 'Who is Hiring', description: '寻找下一段旅程' },
  { href: '/events', place: '活动广场', label: '社区活动', description: '和新朋友碰面' },
  { href: '/contributors', place: '营地', label: '贡献者们', description: '认识世界里的居民' },
];
---

<BaseLayout site={site} title="Rebase 社区首页" description={site.description}>
  <section class="world-hero" aria-labelledby="world-title">
    <div class="hero-scene" aria-hidden="true">
      <img class="hero-layer hero-sky-layer" src="/media/hero/nature/summer/sky.png" alt="" width="1536" height="864" fetchpriority="high" />
      <img class="hero-layer hero-clouds-back" src="/media/hero/nature/summer/cloud-layer-2.png" alt="" width="1536" height="864" />
      <img class="hero-layer hero-clouds-front" src="/media/hero/nature/summer/cloud-layer-1.png" alt="" width="1536" height="864" />
      <img class="hero-layer hero-light-rays" src="/media/hero/nature/summer/light-rays.png" alt="" width="1536" height="864" />
      <img class="hero-layer hero-mountains" src="/media/hero/nature/summer/mountain.png" alt="" width="1536" height="864" style="transform:translateY(26%)" />
      <img class="hero-layer hero-valley" src="/media/hero/nature/summer/valley.png" alt="" width="1536" height="864" style="transform:translateY(22%)" />
      <img class="hero-layer hero-grass-back" src="/media/hero/nature/summer/grass-back.png" alt="" width="1536" height="864" style="transform:translateY(16%)" />
      <img class="hero-layer hero-flowers" src="/media/hero/nature/summer/flowers.png" alt="" width="1536" height="864" style="scale:1 0.68" />
      <img class="hero-layer hero-ground-shadow" src="/media/hero/nature/summer/ground-shadow.png" alt="" width="1536" height="864" />
      <img class="hero-layer hero-mascot" src="/media/hero/nature/summer/mascot.png" alt="" width="1536" height="864" style="scale:0.86" />
      <img class="hero-layer hero-grass-front" src="/media/hero/nature/summer/grass-front.png" alt="" width="1536" height="864" style="scale:1 0.52" />
      <img class="hero-layer hero-leaves" src="/media/hero/nature/summer/leaf-particles.png" alt="" width="1536" height="864" style="scale:0.68" />
    </div>

    <div class="world-hero-content">
      <p class="world-kicker">欢迎来到</p>
      <h1 id="world-title">Rebase</h1>
      <p class="world-intro">由中国开发者用热爱和业余时间共同维护的公益开发者社区</p>
      <a class="world-cta" href="#world-map">进入社区</a>
    </div>

  </section>

  <section id="world-map" class="world-map shell page-section" aria-labelledby="world-map-title">
    <div class="world-map-heading">
      <p>沿着小路逛逛</p>
      <h2 id="world-map-title">今天想去哪里？</h2>
      <span>每一个入口，都是 Rebase World 里真实发生故事的地方。</span>
    </div>

    <nav class="world-gates" aria-label="社区内容入口">
      {worldGates.map((gate, index) => (
        <a class={`world-gate gate-${index + 1}`} href={gate.href}>
          <span class="gate-place">{gate.place}</span>
          <strong>{gate.label}</strong>
          <small>{gate.description}</small>
        </a>
      ))}
    </nav>

    <div class="world-stats" aria-label="社区概览">
      {site.homeStats.map((stat) => (
        <div>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="noticeboard-zone page-section">
    <div class="shell noticeboard-layout">
      <div class="noticeboard-copy">
        <p>公告板</p>
        <h2>社区正在发生什么</h2>
        <span>最新的文章、活动和机会，会在这里留下消息。</span>
        <a href="/geekdaily">去公告板看看</a>
      </div>

      <ol class="noticeboard-list">
        {liveWire.map((item, index) => (
          <li style={`--note-tilt:${index % 2 === 0 ? '-0.7deg' : '0.7deg'}`}>
            <a href={item.href}>
              <div>
                <span>{liveWireTypeLabel[item.type]}</span>
                <time>{item.publishedAt ? formatDate(item.publishedAt) : '刚刚更新'}</time>
              </div>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="shell page-section content-clearing">
    <SectionHeader
      compact
      title="公告板上的极客日报"
      description="从社区每天的阅读和讨论里，挑出值得继续追踪的技术信号。"
      href="/geekdaily"
      hrefLabel="浏览日报"
    />
    <div class="grid-3">
      {recentGeekDaily.map((episode) => <GeekDailyCard episode={episode} compact />)}
    </div>
  </section>

  <section class="library-zone page-section">
    <div class="shell">
      <SectionHeader
        compact
        title="图书馆最近上架"
        description="社区成员写下的想法、方法和复盘，都在这里被好好保存。"
        href="/articles"
        hrefLabel="进入图书馆"
      />
      <div class="grid-3 book-grid">
        {feed.latestArticles.map((article) => <ArticleCard article={article} compact />)}
      </div>
    </div>
  </section>

  <section class="shell page-section station-zone">
    <SectionHeader
      compact
      title="招聘驿站的新消息"
      description="招聘信息由发布者提交，社区志愿者进行基础整理，请在联系前认真判断。"
      href="/who-is-hiring"
      hrefLabel="前往驿站"
    />
    <div class="grid-3">
      {feed.latestJobs.map((job) => <JobCard job={job} compact />)}
    </div>
  </section>

  <section class="plaza-zone page-section">
    <div class="shell">
      <SectionHeader
        compact
        title="活动广场见"
        description="Rebase 主办、参与和协助传播的活动，会在广场留下时间和地点。"
        href="/events"
        hrefLabel="查看活动"
      />
      <div class="grid-3">
        {feed.latestEvents.map((event) => <EventCard event={event} compact />)}
      </div>
    </div>
  </section>

  <section class="camp-zone page-section">
    <div class="shell camp-layout">
      <div class="camp-copy">
        <p>营地</p>
        <h2>每一束光，都来自真实的人</h2>
        <span>编辑、志愿者、活动组织者和长期协作者，一起让这个世界继续生长。</span>
        <a href="/contributors">认识贡献者</a>
      </div>

      <div class="campfire" aria-hidden="true"><span></span></div>

      <div class="contributors-circle" aria-label="贡献者预览">
        {contributorPreview.map((contributor) => (
          <div class="avatar-token" title={contributor.name}>
            {contributor.avatarUrl ? (
              <img src={contributor.avatarUrl} alt={contributor.name} loading="lazy" />
            ) : (
              <div class="avatar-fallback" style={`background:${createAvatarData(contributor.avatarSeed)}`}>
                <span>{contributor.name.slice(0, 1)}</span>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="shell page-section rss-path">
    <div>
      <h2>沿着 RSS，持续收到世界里的新消息</h2>
      <p>订阅全站，或者只选择你关心的内容。</p>
    </div>
    <nav aria-label="RSS 订阅">
      <a class="rss-primary" href="/rss.xml">全站 RSS</a>
      <a href="/geekdaily/rss.xml">极客日报</a>
      <a href="/articles/rss.xml">文章</a>
      <a href="/events/rss.xml">活动</a>
      <a href="/who-is-hiring/rss.xml">招聘</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .world-hero {
    position: relative;
    isolation: isolate;
    min-height: min(52rem, 100dvh);
    overflow: hidden;
    background: linear-gradient(180deg, #48b5e5 0%, #86d4ed 48%, #d8f0dd 74%);
    color: white;
  }

  .hero-scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    user-select: none;
  }

  .hero-sky-layer { z-index: 0; }
  .hero-clouds-back { z-index: 1; }
  .hero-clouds-front { z-index: 2; }
  .hero-light-rays { z-index: 3; opacity: 0.34; mix-blend-mode: screen; }
  .hero-mountains { z-index: 4; transform: translateY(26%); }
  .hero-valley { z-index: 5; transform: translateY(22%); }
  .hero-grass-back { z-index: 6; transform: translateY(16%); }
  .hero-flowers { z-index: 8; scale: 1 0.68; transform-origin: 50% 100%; }
  .hero-ground-shadow { z-index: 9; }
  .hero-mascot { z-index: 12; scale: 0.86; transform-origin: 67% 91%; }
  .hero-grass-front { z-index: 13; scale: 1 0.52; transform-origin: 50% 100%; }
  .hero-leaves { z-index: 14; scale: 0.68; opacity: 0.42; }

  .hero-scene::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 15;
    background: linear-gradient(180deg, rgba(19, 88, 128, 0.06), transparent 45%, rgba(29, 69, 34, 0.08));
  }

  .world-hero-content {
    position: relative;
    z-index: 20;
    display: grid;
    justify-items: center;
    width: min(calc(100% - 2rem), 52rem);
    margin: 0 auto;
    padding-top: clamp(9rem, 20vh, 12rem);
    text-align: center;
    text-shadow: 0 3px 18px rgba(24, 94, 126, 0.3);
  }

  .world-kicker {
    margin: 0 0 0.35rem;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .world-hero h1 {
    margin: 0;
    font-family: 'Comic Sans MS', 'Kaiti SC', 'STKaiti', cursive;
    font-size: clamp(4.6rem, 11vw, 8.5rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: 0;
  }

  .world-intro {
    max-width: 30ch;
    margin: 1rem 0 0;
    font-size: clamp(1rem, 2vw, 1.24rem);
    line-height: 1.8;
  }

  .world-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    margin-top: 1.35rem;
    padding: 0.8rem 1.35rem;
    border: 1px solid rgba(255, 255, 255, 0.62);
    border-radius: 999px;
    background: rgba(255, 253, 244, 0.88);
    color: #315e37;
    font-weight: 800;
    text-shadow: none;
    box-shadow: 0 8px 0 rgba(44, 99, 70, 0.17);
    backdrop-filter: blur(10px);
    transition: transform 200ms ease, box-shadow 200ms ease, background 200ms ease;
  }

  .world-cta:hover,
  .world-cta:focus-visible { transform: translateY(-2px); background: #fffdf4; box-shadow: 0 10px 0 rgba(44, 99, 70, 0.14); }
  .world-cta:active { transform: translateY(1px); box-shadow: 0 4px 0 rgba(44, 99, 70, 0.17); }

  .world-map {
    position: relative;
  }

  .world-map-heading {
    display: grid;
    gap: 0.48rem;
    max-width: 38rem;
    margin-bottom: 2rem;
  }

  .world-map-heading p,
  .world-map-heading h2,
  .world-map-heading span { margin: 0; }
  .world-map-heading p { color: var(--accent-strong); font-weight: 800; }
  .world-map-heading h2 { font-size: clamp(2rem, 4vw, 3.6rem); line-height: 1.08; }
  .world-map-heading span { color: var(--muted); line-height: 1.7; }

  .world-gates {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(8.6rem, auto));
    gap: 1rem;
  }

  .world-gate {
    position: relative;
    overflow: hidden;
    display: grid;
    align-content: end;
    gap: 0.3rem;
    min-height: 10rem;
    padding: 1.2rem;
    border: 1px solid rgba(76, 54, 32, 0.19);
    border-radius: 14px;
    color: #25382a;
    box-shadow: 0 12px 26px rgba(67, 98, 54, 0.1);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .world-gate::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(36, 62, 38, 0.12));
  }

  .world-gate:hover,
  .world-gate:focus-visible { transform: translateY(-4px); box-shadow: 0 18px 34px rgba(67, 98, 54, 0.16); }
  .gate-1 { grid-column: span 2; grid-row: span 2; background: #efd7a2; }
  .gate-2 { grid-column: span 2; background: #c7d3a7; }
  .gate-3 { grid-column: span 2; background: #f0e3bd; }
  .gate-4 { grid-column: span 2; background: #b9ddec; }
  .gate-5 { grid-column: span 2; background: #9eb39a; color: #182c21; }

  .gate-place { color: #527343; font-size: 0.78rem; font-weight: 800; }
  .world-gate strong { font-family: var(--display-font); font-size: 1.5rem; }
  .world-gate small { color: rgba(37, 56, 42, 0.72); font-size: 0.9rem; line-height: 1.5; }

  .world-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.25rem;
  }

  .world-stats div {
    display: flex;
    align-items: baseline;
    gap: 0.42rem;
    padding: 0.72rem 0.95rem;
    border: 1px solid rgba(89, 60, 32, 0.18);
    border-radius: 10px;
    background: #f5e6ba;
    color: var(--wood-dark);
    box-shadow: 0 5px 0 rgba(99, 65, 32, 0.08);
  }

  .world-stats strong { font-size: 1.12rem; }
  .world-stats span { color: #685f4c; font-size: 0.88rem; }

  .noticeboard-zone {
    background: linear-gradient(180deg, rgba(226, 238, 210, 0.45), rgba(214, 231, 192, 0.7));
  }

  .noticeboard-layout {
    display: grid;
    grid-template-columns: minmax(15rem, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  .noticeboard-copy { position: sticky; top: 6rem; display: grid; gap: 0.65rem; }
  .noticeboard-copy p,
  .noticeboard-copy h2,
  .noticeboard-copy span { margin: 0; }
  .noticeboard-copy p { color: var(--accent-strong); font-weight: 800; }
  .noticeboard-copy h2 { font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.05; }
  .noticeboard-copy span { color: var(--muted); line-height: 1.7; }
  .noticeboard-copy a,
  .camp-copy a { width: fit-content; margin-top: 0.5rem; color: var(--accent-strong); font-weight: 800; border-bottom: 2px solid #e2bf55; }

  .noticeboard-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 1.4rem;
    border: 10px solid #754b2a;
    border-radius: 14px;
    background: #b47a43;
    box-shadow: inset 0 0 0 2px rgba(255, 225, 166, 0.16), 0 18px 40px rgba(81, 61, 38, 0.17);
    list-style: none;
  }

  .noticeboard-list li {
    min-width: 0;
    transform: rotate(var(--note-tilt));
  }

  .noticeboard-list a {
    display: block;
    height: 100%;
    padding: 1rem;
    border-radius: 6px;
    background: #fffaf0;
    color: var(--text);
    box-shadow: 0 5px 12px rgba(75, 47, 24, 0.2);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .noticeboard-list a:hover,
  .noticeboard-list a:focus-visible { transform: translateY(-3px) rotate(0); box-shadow: 0 9px 18px rgba(75, 47, 24, 0.22); }
  .noticeboard-list a > div { display: flex; justify-content: space-between; gap: 0.8rem; color: #6f7b66; font-size: 0.75rem; font-weight: 700; }
  .noticeboard-list h3 { margin: 0.6rem 0 0; font-size: 1.05rem; line-height: 1.35; }
  .noticeboard-list p { display: -webkit-box; overflow: hidden; margin: 0.45rem 0 0; color: var(--muted); font-size: 0.9rem; line-height: 1.6; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }

  .content-clearing { position: relative; }
  .library-zone { background: linear-gradient(180deg, rgba(238, 230, 201, 0.6), rgba(226, 235, 204, 0.38)); }
  .plaza-zone { background: linear-gradient(180deg, rgba(190, 225, 229, 0.48), rgba(226, 239, 210, 0.45)); }

  .book-grid :global(.article-card) { border-bottom: 8px solid #805834; transform-origin: 50% 100%; }
  .book-grid :global(.article-card:hover),
  .book-grid :global(.article-card:focus-within) { transform: translateY(-5px) rotate(-0.3deg); }

  .camp-zone {
    overflow: hidden;
    color: #f7f0d8;
    background: linear-gradient(180deg, #24434d 0, #243d35 58%, #334d35 100%);
  }

  .camp-layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(15rem, 0.65fr) minmax(0, 1.35fr);
    gap: 2rem;
    align-items: center;
    min-height: 30rem;
  }

  .camp-copy { display: grid; gap: 0.72rem; max-width: 28rem; }
  .camp-copy p,
  .camp-copy h2,
  .camp-copy span { margin: 0; }
  .camp-copy p { color: #f5c94a; font-weight: 800; }
  .camp-copy h2 { color: #fff7df; font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.08; }
  .camp-copy span { color: #cfddcf; line-height: 1.75; }
  .camp-copy a { color: #fff3ba; }

  .contributors-circle {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(5, minmax(3.6rem, 5.5rem));
    gap: 1.15rem;
    justify-content: end;
  }

  .avatar-token { overflow: hidden; aspect-ratio: 1; border: 3px solid rgba(255, 232, 158, 0.58); border-radius: 50%; background: #fff8e6; box-shadow: 0 0 24px rgba(246, 182, 72, 0.28); transition: transform 220ms ease, box-shadow 220ms ease; }
  .avatar-token:hover { transform: translateY(-4px); box-shadow: 0 0 34px rgba(246, 182, 72, 0.54); }
  .avatar-token img,
  .avatar-fallback { width: 100%; height: 100%; object-fit: cover; }
  .avatar-fallback { display: grid; place-items: center; color: white; font-size: 1.4rem; font-weight: 800; }

  .campfire {
    position: absolute;
    right: 29%;
    bottom: -1.5rem;
    width: 7rem;
    height: 6rem;
    z-index: 1;
    border-radius: 50%;
    background: rgba(246, 177, 66, 0.12);
    box-shadow: 0 0 70px 28px rgba(246, 177, 66, 0.12);
  }

  .campfire::before,
  .campfire span { content: ''; position: absolute; left: 50%; bottom: 1rem; width: 2.8rem; height: 4.2rem; border-radius: 70% 30% 60% 40%; background: #ee9240; transform: translateX(-50%) rotate(8deg); }
  .campfire span { bottom: 1.2rem; width: 1.5rem; height: 2.8rem; background: #ffd75a; transform: translateX(-50%) rotate(-9deg); }

  .rss-path {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .rss-path h2,
  .rss-path p { margin: 0; }
  .rss-path h2 { font-size: clamp(1.55rem, 2.5vw, 2.35rem); line-height: 1.15; }
  .rss-path p { margin-top: 0.5rem; color: var(--muted); }
  .rss-path nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.55rem; }
  .rss-path a { padding: 0.62rem 0.82rem; border: 1px solid rgba(75, 50, 31, 0.17); border-radius: 999px; background: rgba(255, 253, 244, 0.72); color: var(--wood-dark); font-size: 0.9rem; font-weight: 700; }
  .rss-path .rss-primary { border-color: var(--wood-dark); background: var(--wood-dark); color: white; }

  @media (prefers-reduced-motion: no-preference) {
    .hero-clouds-back { animation: hero-clouds-back 72s ease-in-out infinite alternate; }
    .hero-clouds-front { animation: hero-clouds-front 48s ease-in-out infinite alternate; }
    .hero-light-rays { animation: hero-light 9s ease-in-out infinite; }
    .hero-flowers { animation: hero-flowers 5.2s ease-in-out infinite alternate; }
    .hero-mascot { animation: hero-mascot-breathe 4.8s ease-in-out infinite; }
    .hero-grass-front { animation: hero-grass 6.2s ease-in-out infinite alternate; }
    .hero-leaves { animation: hero-leaves 19s ease-in-out infinite alternate; }
    .campfire::before { animation: flame 1.6s ease-in-out infinite alternate; }
  }

  @keyframes hero-clouds-back { from { transform: translate3d(-1.2%, 0, 0) scale(1.025); } to { transform: translate3d(1.2%, 0, 0) scale(1.025); } }
  @keyframes hero-clouds-front { from { transform: translate3d(1.8%, 0, 0) scale(1.04); } to { transform: translate3d(-1.8%, 0, 0) scale(1.04); } }
  @keyframes hero-light { 0%, 100% { opacity: 0.26; } 50% { opacity: 0.48; } }
