---
import type { SiteSettings } from '@rebase/types';

interface Props {
  site: SiteSettings;
}

const { site } = Astro.props;
const isExternalLink = (href: string) => href.startsWith('http');
const footerSummary = site.tagline.trim()
  ? `${site.tagline.trim().replace(/[。！!？?]+$/u, '')}。`
  : site.description;
const socialIconMap: Record<string, string> = {
  'B 站': '/social-icons/bilibili.svg',
  YouTube: '/social-icons/youtube.svg',
  Discord: '/social-icons/discord.svg',
  Twitter: '/social-icons/x.svg',
  Telegram: '/social-icons/telegram.svg',
  GitHub: '/social-icons/github.svg',
  微信公众号: '/social-icons/wechat.svg',
  'QQ 群': '/social-icons/qq.svg',
};
const socialQrCodeMap: Record<
  string,
  { id: string; src: string; title: string; prompt: string; size: number }
> = {
  微信公众号: {
    id: 'wechat-qr-dialog',
    src: '/qrcodes/wechat-official.jpg',
    title: '关注 Rebase 微信公众号',
    prompt: '打开微信，扫描二维码关注 Rebase 社区。',
    size: 760,
  },
  'QQ 群': {
    id: 'qq-qr-dialog',
    src: '/qrcodes/qq-group.jpg',
    title: '加入 Rebase QQ 群',
    prompt: '打开 QQ，扫描二维码加入群聊（群号：1001507060）。',
    size: 1024,
  },
};
---

<footer class="site-footer">
  <div class="shell footer-frame card">
    <div class="footer-top">
      <div class="footer-brand">
        <img
          class="footer-logo"
          src="/brand/rebase-logo-wordmark.svg"
          alt="Rebase 社区"
          width="225"
          height="101"
        />
        <div>
          <p class="summary">{footerSummary}</p>
        </div>
      </div>
    </div>

    <div class="footer-grid">
      {site.footerGroups.map((group) => (
        <section>
          <h3>{group.title}</h3>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href} target={isExternalLink(link.href) ? '_blank' : undefined} rel="noreferrer">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div class="footer-meta">
      <div class="socials">
        {site.socialLinks.map((item) => {
          const qrCode = socialQrCodeMap[item.label];
          return qrCode ? (
            <button
              type="button"
              data-qr-dialog={qrCode.id}
              aria-label={item.label}
              aria-haspopup="dialog"
              aria-controls={qrCode.id}
              title={item.label}
            >
              <img src={socialIconMap[item.label]} alt="" width="20" height="20" loading="lazy" />
            </button>
          ) : (
            <a href={item.href} target="_blank" rel="noreferrer" aria-label={item.label} title={item.label}>
              {socialIconMap[item.label] ? (
                <img src={socialIconMap[item.label]} alt="" width="20" height="20" loading="lazy" />
              ) : (
                <span>{item.label}</span>
              )}
            </a>
          );
        })}
      </div>
      <p>{site.copyright}</p>
    </div>
  </div>
</footer>

{Object.values(socialQrCodeMap).map((qrCode) => (
  <dialog class="qr-dialog" id={qrCode.id} aria-labelledby={`${qrCode.id}-title`}>
    <div class="qr-dialog-header">
      <h2 id={`${qrCode.id}-title`}>{qrCode.title}</h2>
      <form method="dialog">
        <button type="submit" class="qr-dialog-close" aria-label="关闭二维码弹窗">×</button>
      </form>
    </div>
    <img
      src={qrCode.src}
      alt={`${qrCode.title}二维码`}
      width={qrCode.size}
      height={qrCode.size}
      decoding="async"
    />
    <p>{qrCode.prompt}</p>
  </dialog>
))}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-qr-dialog]').forEach((button) => {
    button.addEventListener('click', () => {
      const dialog = document.getElementById(button.dataset.qrDialog ?? '') as HTMLDialogElement | null;
      dialog?.showModal();
    });
  });
</script>

<style>
  .site-footer {
    padding: 3.5rem 0 2rem;
  }

  .footer-frame {
    padding: 1.75rem;
    background:
      radial-gradient(circle at top left, rgba(243, 196, 110, 0.18), transparent 24%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(248, 252, 251, 0.9));
  }

  .footer-top {
    display: block;
    padding-bottom: 1.35rem;
    border-bottom: 1px solid var(--line);
  }

  .footer-brand {
    display: grid;
    gap: 0.72rem;
  }

  .footer-logo {
    display: block;
    width: clamp(8.2rem, 13vw, 10.4rem);
    height: auto;
  }

  .summary {
    margin: 0;
    max-width: 60ch;
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.72;
  }

  h3 {
    color: var(--accent-strong);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    padding: 1.75rem 0;
  }

  h3 {
    margin: 0 0 0.8rem;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    margin-top: 0.55rem;
  }

  li a,
  .socials :is(a, button) {
    color: var(--muted);
    line-height: 1.6;
    transition: color 180ms ease, transform 180ms ease, opacity 180ms ease;
  }

  li a:hover,
  li a:focus-visible,
  .socials :is(a, button):hover,
  .socials :is(a, button):focus-visible {
    color: var(--accent-strong);
  }

  .footer-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.94rem;
  }

  .footer-meta p {
    margin: 0;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.95rem;
  }

  .socials :is(a, button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    min-height: 1.25rem;
    opacity: 0.78;
  }

  .socials button {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .socials :is(a, button):hover,
  .socials :is(a, button):focus-visible {
    opacity: 1;
    transform: translateY(-1px);
  }

  .socials img {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
  }

  .socials span {
    font-size: 0.88rem;
    line-height: 1;
    white-space: nowrap;
  }

  .qr-dialog {
    width: 25rem;
    max-width: calc(100% - 2rem);
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface-strong);
    color: var(--text);
    box-shadow: var(--shadow-strong);
  }

  .qr-dialog::backdrop {
    background: rgba(31, 41, 51, 0.56);
    backdrop-filter: blur(3px);
  }

  .qr-dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .qr-dialog h2,
  .qr-dialog p {
    margin: 0;
  }

  .qr-dialog h2 {
    font-size: 1.1rem;
  }

  .qr-dialog > img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .qr-dialog p {
    margin-top: 1rem;
    color: var(--muted);
    line-height: 1.6;
    text-align: center;
  }

  .qr-dialog-close {
    display: grid;
    width: 2rem;
    height: 2rem;
    padding: 0;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
  }

  @media (max-width: 920px) {
    .footer-top,
    .footer-grid,
    .footer-meta {
      grid-template-columns: 1fr;
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .footer-frame {
      padding: 1.4rem;
    }

    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
