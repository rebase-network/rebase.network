---
type IconName = 'newspaper' | 'briefcase' | 'pencil' | 'calendar' | 'users' | 'info';

interface Props {
  name: IconName;
}

const { name } = Astro.props;
---

<svg
  class="hero-nav-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'newspaper' && (
    <>
      <path d="M4 22h16a2 2 0 0 0 2-2V4H6v16a2 2 0 0 1-2 2Z" />
      <path d="M2 6h4" />
      <path d="M2 10h4" />
      <path d="M2 14h4" />
      <path d="M2 18h4" />
      <path d="M10 8h8" />
      <path d="M10 12h8" />
      <path d="M10 16h8" />
    </>
  )}
  {name === 'briefcase' && (
    <>
      <path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2" />
      <path d="M8 19H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3" />
      <path d="M3 12h10" />
      <circle cx="17" cy="17" r="3" />
      <path d="m19.2 19.2 2.3 2.3" />
    </>
  )}
  {name === 'pencil' && (
    <>
      <path d="M21.2 6.8 17.2 2.8a2 2 0 0 0-2.8 0L3 14.2 2 22l7.8-1 11.4-11.4a2 2 0 0 0 0-2.8Z" />
      <path d="m13.5 3.7 6.8 6.8" />
      <path d="m3 14.2 6.8 6.8" />
    </>
  )}
  {name === 'calendar' && (
    <>
      <path d="M8 2v4" />
      <path d="M16 2v4" />
      <rect width="18" height="18" x="3" y="4" rx="2" />
      <path d="M3 10h18" />
      <path d="M8 14h.01" />
      <path d="M12 14h.01" />
      <path d="M16 14h.01" />
      <path d="M8 18h.01" />
      <path d="M12 18h.01" />
    </>
  )}
  {name === 'users' && (
    <>
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
      <circle cx="9" cy="7" r="4" />
      <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
      <path d="M16 3.13a4 4 0 0 1 0 7.75" />
    </>
  )}
  {name === 'info' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 11v5" />
      <path d="M12 8h.01" />
    </>
  )}
</svg>

<style>
  .hero-nav-icon {
    width: clamp(2.15rem, 4.4vw, 3rem);
    height: clamp(2.15rem, 4.4vw, 3rem);
    overflow: visible;
    filter: drop-shadow(0 2px 5px rgba(21, 90, 126, 0.22));
  }
</style>
